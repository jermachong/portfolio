---
import backgroundVideo from "../assets/video/background-video.mp4";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Work in Progress | Jeremy Achong</title>
  </head>
  <body>
    <main>
      <h1>Work in progress!</h1>
      
      <video autoplay loop muted playsinline>
        <source src={backgroundVideo} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
      

      <p>
        The garge needs some new equipment. In the meantime, feel free to connect with me on  
        <a href="https://www.linkedin.com/in/jeremy-achong/" target="_blank" rel="noopener noreferrer"> LinkedIn</a>.
      </p>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, -apple-system, sans-serif;
    background-color: #1F1F1F;
    color: #f3f4f6;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  main {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
  }

  h1 {
    font-size: 3rem;
    margin: 0;
    letter-spacing: -0.05em;
  }

  video {
    max-width: 100%;
    width: 600px; 
    border-radius: 12px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
    background-color: #000; /* Fallback while loading */
  }

  p {
    font-size: 1.25rem;
    color: #9ca3af;
  }

  a {
    color: #60a5fa; 
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  a:hover {
    color: #93c5fd;
    text-decoration: underline;
  }
</style>